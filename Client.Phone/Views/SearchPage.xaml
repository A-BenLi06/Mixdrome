<Page x:Class="Mixdrome.Phone.Views.SearchPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="using:Mixdrome.Phone.Common" Background="Black">
<Page.Resources><Thickness x:Key="PivotHeaderItemMargin">0,-6.5,0,0</Thickness><DataTemplate x:Key="SearchHeadingTemplate"><TextBlock Text="{Binding}" FontSize="54" FontFamily="{StaticResource PhoneReferenceSemiLightFontFamily}" FontWeight="SemiLight" CharacterSpacing="0" /></DataTemplate><DataTemplate x:Key="SearchRowTemplate"><Grid Margin="12,0,12,12" MinHeight="72"><Grid.ColumnDefinitions><ColumnDefinition Width="72" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Background="{StaticResource MixRadioPanelAltBrush}"><Grid><Image Source="{Binding CoverArt}" Opacity="{Binding ImageOpacity}" Stretch="UniformToFill" /><TextBlock Text="{Binding Glyph}" Style="{StaticResource PhoneTileGlyphStyle}" /></Grid></Border><StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"><TextBlock Text="{Binding Title}" FontSize="26" Foreground="White" MaxLines="1" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Subtitle}" Style="{StaticResource BodyTextStyle}" MaxLines="1" TextTrimming="CharacterEllipsis" /></StackPanel></Grid></DataTemplate></Page.Resources>
<Page.BottomAppBar><CommandBar Background="{StaticResource MixRadioCommandBarBrush}"><AppBarButton Icon="Find" x:Uid="PhoneUi_Label_Search" Click="OnSearchButtonClick" /><AppBarButton Icon="Clear" x:Uid="PhoneUi_Label_Clear" Click="OnClearClick" /><AppBarButton x:Name="MoreButton" Icon="More" x:Uid="PhoneUi_Label_More" Click="OnMoreClick" Visibility="Collapsed" /></CommandBar></Page.BottomAppBar>
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
<common:PhoneTitleBar x:Name="SectionBar" />
<TextBox x:Name="SearchTextBox" Grid.Row="1" Style="{StaticResource MixRadioPhoneTextBoxStyle}" x:Uid="PhoneUi_PlaceholderText_FindArtistsAlbumsOrSongs" Margin="20,12,20,0" KeyDown="OnSearchTextBoxKeyDown" />
<Grid Grid.Row="2"><Pivot x:Name="ResultsPivot" HeaderTemplate="{StaticResource SearchHeadingTemplate}" SelectionChanged="OnResultsTabChanged"><PivotItem x:Uid="PhoneUi_Header_Artists"><ListView ItemsSource="{Binding ArtistResults}" ItemTemplate="{StaticResource SearchRowTemplate}" ItemContainerStyle="{StaticResource AlbumListItemStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnResultClick" /></PivotItem>
<PivotItem x:Uid="PhoneUi_Header_Albums"><ListView ItemsSource="{Binding AlbumResults}" ItemTemplate="{StaticResource SearchRowTemplate}" ItemContainerStyle="{StaticResource AlbumListItemStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnResultClick" /></PivotItem>
<PivotItem x:Uid="PhoneUi_Header_Songs"><ListView ItemsSource="{Binding TrackResults}" ItemTemplate="{StaticResource SearchRowTemplate}" ItemContainerStyle="{StaticResource AlbumListItemStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnResultClick" /></PivotItem></Pivot><ProgressRing x:Name="LoadingIndicator" Width="48" Height="48" IsActive="False" HorizontalAlignment="Center" VerticalAlignment="Center" /><TextBlock x:Name="EmptyStateText" x:Uid="PhoneUi_Text_TypeSomethingToSearchYourMusic" Style="{StaticResource SubHeaderTextStyle}" TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Margin="32" /></Grid>
</Grid></Page>
