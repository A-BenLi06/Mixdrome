<Page x:Class="Mixdrome.Phone.Views.LibraryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:common="using:Mixdrome.Phone.Common"
      Background="Black">
    <Page.Resources>
        <Thickness x:Key="PivotHeaderItemMargin">0,-6.5,0,0</Thickness>
        <DataTemplate x:Key="LibraryHeadingTemplate"><TextBlock Text="{Binding}" FontSize="54" FontFamily="{StaticResource PhoneReferenceSemiLightFontFamily}" FontWeight="SemiLight" CharacterSpacing="0" /></DataTemplate>
        <Style x:Key="LibraryPlayButtonStyle" TargetType="Button" BasedOn="{StaticResource CircularButtonStyle}">
            <Setter Property="Width" Value="44" /><Setter Property="Height" Value="44" />
            <Setter Property="MinWidth" Value="44" /><Setter Property="MinHeight" Value="44" />
        </Style>
        <Style x:Key="LibraryNameTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Foreground" Value="{StaticResource ApplicationForegroundThemeBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" /><Setter Property="MaxLines" Value="2" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <DataTemplate x:Key="LibraryNamedRowTemplate">
            <Grid Margin="12,0,12,12" MinHeight="60">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button Tag="{Binding}" Click="OnPlayItemClick" Style="{StaticResource LibraryPlayButtonStyle}"
                        VerticalAlignment="Center" Margin="0,0,14,0" AutomationProperties.Name="{Binding PlayLabel}">
                    <Polygon Points="0,0 0,18 11,9" Fill="White" Margin="3,0,0,0" />
                </Button>
                <Button Grid.Column="1" Tag="{Binding}" Click="OnOpenItemClick" Style="{StaticResource MixRadioFlatButtonStyle}"
                        MinHeight="60" AutomationProperties.Name="{Binding OpenLabel}">
                    <TextBlock Text="{Binding Name}" Style="{StaticResource LibraryNameTextStyle}" VerticalAlignment="Center" />
                </Button>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="LibraryAlbumRowTemplate">
            <Grid Margin="12,0,12,12" MinHeight="96">
                <Grid.ColumnDefinitions><ColumnDefinition Width="96" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Button Tag="{Binding}" Click="OnPlayItemClick" Width="96" Height="96"
                        Style="{StaticResource MixRadioFlatButtonStyle}" AutomationProperties.Name="{Binding PlayLabel}">
                    <Grid>
                        <Image Source="{Binding CoverArt}" Stretch="UniformToFill" />
                        <Grid Width="28" Height="28" Margin="0,5,5,0" HorizontalAlignment="Right" VerticalAlignment="Top" FlowDirection="LeftToRight">
                            <Ellipse Stroke="White" StrokeThickness="2.4" />
                            <Polygon Points="0,0 0,10 7.5,5" Fill="White" Margin="2,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                </Button>
                <Button Grid.Column="1" Tag="{Binding}" Click="OnOpenItemClick" Margin="12,0,0,0" MinHeight="96"
                        Style="{StaticResource MixRadioFlatButtonStyle}" AutomationProperties.Name="{Binding OpenLabel}">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource LibraryNameTextStyle}" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource BodyTextStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="LibrarySongRowTemplate">
            <StackPanel Margin="12,0,12,12" MinHeight="60" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" Style="{StaticResource LibraryNameTextStyle}" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource BodyTextStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
        </DataTemplate>
        <DataTemplate x:Key="LibraryPlaylistRowTemplate">
            <StackPanel Margin="12,0,12,12" MinHeight="60" VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}" Style="{StaticResource LibraryNameTextStyle}" />
                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource BodyTextStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" />
            </StackPanel>
        </DataTemplate>
        <Style x:Key="LibraryItemContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="0" />
        </Style>
    </Page.Resources>
    <Page.BottomAppBar>
        <CommandBar Background="{StaticResource MixRadioCommandBarBrush}">
            <AppBarButton Icon="Find" x:Uid="PhoneUi_Label_Search" Click="OnSearchClick" />
            <AppBarButton Icon="Refresh" x:Uid="PhoneUi_Label_Refresh" Click="OnRefreshClick" />
            <AppBarButton x:Name="MoreButton" Icon="More" x:Uid="PhoneUi_Label_More" Click="OnMoreClick" Visibility="Collapsed" />
        </CommandBar>
    </Page.BottomAppBar>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <common:PhoneTitleBar x:Name="SectionBar" />
        <Pivot x:Name="LibraryPivot" Grid.Row="1" HeaderTemplate="{StaticResource LibraryHeadingTemplate}" SelectionChanged="OnTabChanged">
            <PivotItem x:Uid="PhoneUi_Header_Artists" Tag="artists"><ListView ItemsSource="{Binding Artists}" ItemTemplate="{StaticResource LibraryNamedRowTemplate}" ItemContainerStyle="{StaticResource LibraryItemContainerStyle}" SelectionMode="None" /></PivotItem>
            <PivotItem x:Uid="PhoneUi_Header_Albums" Tag="albums"><ListView ItemsSource="{Binding Albums}" ItemTemplate="{StaticResource LibraryAlbumRowTemplate}" ItemContainerStyle="{StaticResource LibraryItemContainerStyle}" SelectionMode="None" /></PivotItem>
            <PivotItem x:Uid="PhoneUi_Header_Songs" Tag="songs">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Button x:Name="ShuffleSongsButton" Click="OnShuffleAllClick" Style="{StaticResource MixRadioFlatButtonStyle}" Margin="12,0,12,12" MinHeight="60" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid Width="44" Height="44" FlowDirection="LeftToRight">
                                <Ellipse Stroke="White" StrokeThickness="2" />
                                <Polygon Points="0,0 0,18 11,9" Fill="White" Margin="3,0,0,0" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Grid.Column="1" x:Uid="PhoneUi_Text_ShuffleAll" Style="{StaticResource LibraryNameTextStyle}" Margin="14,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <ListView Grid.Row="1" ItemsSource="{Binding Songs}" ItemTemplate="{StaticResource LibrarySongRowTemplate}" ItemContainerStyle="{StaticResource LibraryItemContainerStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnItemClick" />
                </Grid>
            </PivotItem>
            <PivotItem x:Uid="PhoneUi_Header_Genres" Tag="genres"><ListView ItemsSource="{Binding Genres}" ItemTemplate="{StaticResource LibraryNamedRowTemplate}" ItemContainerStyle="{StaticResource LibraryItemContainerStyle}" SelectionMode="None" /></PivotItem>
            <PivotItem x:Uid="PhoneUi_Header_Playlists" Tag="playlists"><ListView ItemsSource="{Binding Playlists}" ItemTemplate="{StaticResource LibraryPlaylistRowTemplate}" ItemContainerStyle="{StaticResource LibraryItemContainerStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnItemClick" /></PivotItem>
        </Pivot>
        <StackPanel Grid.Row="2" Margin="20,0,20,12">
            <TextBlock x:Name="StatusText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" />
            <ProgressRing x:Name="LoadingIndicator" IsActive="False" Width="32" Height="32" Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Page>
