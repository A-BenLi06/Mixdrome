<Page x:Class="Mixdrome.Phone.Views.AlbumPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:common="using:Mixdrome.Phone.Common" Background="Black">
<Page.BottomAppBar><CommandBar Background="{StaticResource MixRadioCommandBarBrush}"><AppBarButton Icon="Play" x:Uid="PhoneUi_Label_PlayAll" Click="OnPlayAllClick" /><AppBarButton Icon="Shuffle" x:Uid="PhoneUi_Label_Shuffle" Click="OnShuffleClick" /></CommandBar></Page.BottomAppBar>
<Grid><Image x:Name="AlbumBackgroundImage" Stretch="UniformToFill" Opacity="0.2" /><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
<common:PhoneTitleBar x:Name="SectionBar" />
<Grid Grid.Row="1" Margin="20,20,20,20"><Grid.ColumnDefinitions><ColumnDefinition Width="0.38*" /><ColumnDefinition Width="0.62*" /></Grid.ColumnDefinitions>
<Image x:Name="AlbumArtImage" Stretch="Uniform" Source="ms-appx:///Assets/MixRadio/DefaultArtwork300.png" />
<StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"><TextBlock x:Name="AlbumNameText" Style="{StaticResource SubHeaderTextStyle}" TextWrapping="Wrap" MaxLines="3" /><TextBlock x:Name="ArtistNameText" Style="{StaticResource TitleTextStyle}" TextWrapping="Wrap" MaxLines="2" Margin="0,8,0,0" /><TextBlock x:Name="SongCountText" Style="{StaticResource BodyTextStyle}" Margin="0,8,0,0" /></StackPanel></Grid>
<ListView x:Name="SongListView" Grid.Row="2" ItemsSource="{Binding Songs}" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OnSongClick">
<ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="MinHeight" Value="64" /><Setter Property="Padding" Value="20,8" /></Style></ListView.ItemContainerStyle>
<ListView.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Track}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Margin="8,0,8,0"><TextBlock Text="{Binding Title}" Style="{StaticResource TitleTextStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" /><TextBlock Text="{Binding Artist}" Style="{StaticResource BodyTextStyle}" TextTrimming="CharacterEllipsis" MaxLines="1" /></StackPanel><TextBlock Grid.Column="2" Text="{Binding DurationString}" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" /></Grid></DataTemplate></ListView.ItemTemplate></ListView>
<StackPanel Grid.Row="3" Margin="20,0,20,12"><TextBlock x:Name="AlbumStatusText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" /><ProgressRing x:Name="LoadingIndicator" Width="32" Height="32" IsActive="False" /></StackPanel>
</Grid></Grid></Page>
