<Page x:Class="Mixdrome.Phone.Views.FavouritesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:common="using:Mixdrome.Phone.Common"
      Background="Black" SizeChanged="OnPageSizeChanged">
    <Page.Resources>
        <Thickness x:Key="PivotHeaderItemMargin">0,-6.5,0,0</Thickness>
        <CollectionViewSource x:Name="ArtistGroupsSource" IsSourceGrouped="True" />
        <DataTemplate x:Key="FavouriteHeadingTemplate"><TextBlock Text="{Binding Name}" FontSize="{Binding Size}" FontFamily="{StaticResource PhoneReferenceSemiLightFontFamily}" FontWeight="SemiLight" CharacterSpacing="0" Margin="{Binding Margin}" /></DataTemplate>
        <Style x:Key="FavouriteRowContainerStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="0" />
        </Style>
        <DataTemplate x:Key="FavouriteArtistTemplate">
            <Grid Margin="{Binding RowMargin}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Image Width="{Binding Size}" Height="{Binding Size}" Source="{Binding Artwork}" Stretch="UniformToFill" VerticalAlignment="Top" ImageFailed="OnArtistArtworkFailed" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="{Binding NameSize}" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" Margin="{Binding NameMargin}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="FavouriteAlbumTemplate">
            <Grid Margin="{Binding RowMargin}">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Image Width="{Binding Size}" Height="{Binding Size}" Source="{Binding Artwork}" Stretch="UniformToFill" VerticalAlignment="Top" ImageFailed="OnArtworkFailed" />
                <StackPanel Grid.Column="1" Margin="{Binding NameMargin}">
                    <TextBlock Text="{Binding Name}" FontSize="{Binding NameSize}" FontWeight="Bold" Foreground="White" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="{Binding SubtitleSize}" Foreground="White" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="FavouriteSongTemplate">
            <StackPanel Margin="12,0,12,14"><TextBlock Text="{Binding Name}" FontSize="24" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" /><TextBlock Text="{Binding Subtitle}" Style="{StaticResource BodyTextStyle}" /></StackPanel>
        </DataTemplate>
    </Page.Resources>
    <Page.BottomAppBar>
        <CommandBar x:Name="FavouritesCommandBar" Background="{StaticResource MixRadioCommandBarBrush}">
            <AppBarButton x:Name="AddArtistButton" Icon="Add" x:Uid="PhoneUi_Label_AddArtist" Click="OnAddArtistClick" />
            <AppBarButton x:Name="SelectArtistsButton" Icon="List" x:Uid="PhoneUi_Label_SelectArtists" Click="OnSelectArtistsClick" />
            <AppBarButton x:Name="RemoveArtistsButton" Icon="Delete" x:Uid="PhoneUi_Label_RemoveFavourites" Click="OnRemoveArtistsClick" Visibility="Collapsed" />
            <AppBarButton x:Name="DoneButton" Icon="Accept" x:Uid="PhoneUi_Label_Done" Click="OnDoneClick" Visibility="Collapsed" />
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="MoreButton" x:Uid="PhoneUi_Label_More" Click="OnMoreClick" Visibility="Collapsed" />
                <AppBarButton x:Name="PlayAllButton" x:Uid="PhoneUi_Label_PlayAll" Click="OnPlayAllClick" />
                <AppBarButton x:Name="ShuffleButton" x:Uid="PhoneUi_Label_Shuffle" Click="OnShuffleClick" />
                <AppBarButton x:Uid="PhoneUi_Label_Refresh" Click="OnRefreshClick" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <common:PhoneTitleBar x:Name="SectionBar" />
        <Pivot x:Name="FavouritesPivot" Grid.Row="1" HeaderTemplate="{StaticResource FavouriteHeadingTemplate}" SelectionChanged="OnTabChanged">
            <PivotItem x:Name="ArtistsTab" Tag="artists" Margin="0">
                <ListView x:Name="ArtistsList" ItemsSource="{Binding Source={StaticResource ArtistGroupsSource}}" ItemTemplate="{StaticResource FavouriteArtistTemplate}" ItemContainerStyle="{StaticResource FavouriteRowContainerStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnItemClick">
                    <ListView.GroupStyle><GroupStyle HidesIfEmpty="True"><GroupStyle.HeaderTemplate><DataTemplate>
                        <Border Width="{Binding Size}" Height="{Binding Size}" Margin="{Binding Margin}" HorizontalAlignment="Left" Background="{ThemeResource PhoneAccentBrush}"><TextBlock Text="{Binding Key}" FontSize="{Binding FontSize}" FontWeight="Light" Foreground="White" Margin="6,0,0,0" VerticalAlignment="Bottom" /></Border>
                    </DataTemplate></GroupStyle.HeaderTemplate></GroupStyle></ListView.GroupStyle>
                </ListView>
            </PivotItem>
            <PivotItem x:Name="UpdatesTab" Tag="updates" Margin="0"><ListView x:Name="UpdatesList" ItemsSource="{Binding Updates}" ItemTemplate="{StaticResource FavouriteAlbumTemplate}" ItemContainerStyle="{StaticResource FavouriteRowContainerStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnItemClick" /></PivotItem>
            <PivotItem x:Name="AlbumsTab" Tag="albums" Margin="0"><ListView ItemsSource="{Binding Albums}" ItemTemplate="{StaticResource FavouriteAlbumTemplate}" ItemContainerStyle="{StaticResource FavouriteRowContainerStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnItemClick" /></PivotItem>
            <PivotItem x:Name="SongsTab" Tag="songs" Margin="0"><ListView ItemsSource="{Binding Songs}" ItemTemplate="{StaticResource FavouriteSongTemplate}" ItemContainerStyle="{StaticResource FavouriteRowContainerStyle}" IsItemClickEnabled="True" SelectionMode="None" ItemClick="OnItemClick" /></PivotItem>
        </Pivot>
        <StackPanel x:Name="StatusPanel" Grid.Row="2" Margin="24,0,24,8" Visibility="Collapsed"><TextBlock x:Name="StatusText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap" /><ProgressRing x:Name="LoadingIndicator" Width="32" Height="32" /></StackPanel>
    </Grid>
</Page>
