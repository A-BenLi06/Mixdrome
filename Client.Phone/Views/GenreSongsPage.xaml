<Page
    x:Class="Mixdrome.Phone.Views.GenreSongsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:Mixdrome.Phone.Common"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="Black">

    <Page.BottomAppBar>
        <CommandBar Background="{StaticResource MixRadioCommandBarBrush}" Foreground="White">
            <AppBarButton Icon="Play" x:Uid="PhoneUi_Label_PlayAll" Click="OnPlayAllClick" />
            <AppBarButton Icon="Shuffle" x:Uid="PhoneUi_Label_Shuffle" Click="OnShuffleClick" />
        </CommandBar>
    </Page.BottomAppBar>

    <Grid Background="Black">
        <Image Source="ms-appx:///Assets/MixRadio/DefaultArtist300.png" Stretch="UniformToFill" Opacity="0.5" />
        <Rectangle Fill="#66000000" />
        <Rectangle>
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#11000000" Offset="0" />
                    <GradientStop Color="#88000000" Offset="0.48" />
                    <GradientStop Color="#FF000000" Offset="1" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <common:PhoneTitleBar x:Name="SectionBar" />
            <StackPanel Grid.Row="1" Margin="20,12,20,22">
                <TextBlock x:Name="GenreNameText"
                           x:Uid="PhoneUi_Text_Genre"
                           FontSize="42"
                           FontWeight="Light"
                           Foreground="White"
                           TextWrapping="Wrap"
                           MaxLines="2" />
                <TextBlock x:Name="SongCountText"
                           x:Uid="PhoneUi_Text_Songs"
                           Style="{StaticResource BodyTextStyle}"
                           Margin="0,4,0,0" />
                <Rectangle Width="64"
                           Height="4"
                           Fill="{StaticResource MixRadioAccentBrush}"
                           HorizontalAlignment="Left"
                           Margin="0,16,0,0" />
            </StackPanel>

            <Grid Grid.Row="2">
                <ListView ItemsSource="{Binding Songs}"
                          SelectionMode="None"
                          IsItemClickEnabled="True"
                          ItemClick="OnSongClick"
                          Background="Transparent">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="58" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="12,0,12,10"
                                  MinHeight="58"
                                  Background="Transparent">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Track}"
                                           FontSize="18"
                                           FontWeight="Light"
                                           Foreground="{StaticResource MixRadioGreenBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />

                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Margin="0,0,12,0">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="23"
                                               FontWeight="Light"
                                               Foreground="White"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                    <TextBlock Text="{Binding Artist}"
                                               Style="{StaticResource BodyTextStyle}"
                                               Foreground="#CCFFFFFF"
                                               TextTrimming="CharacterEllipsis"
                                               MaxLines="1" />
                                </StackPanel>

                                <TextBlock Grid.Column="2"
                                           Text="{Binding DurationString}"
                                           Style="{StaticResource BodyTextStyle}"
                                           Foreground="#B3FFFFFF"
                                           VerticalAlignment="Center"
                                           Margin="0,0,4,0" />
                                <Rectangle Grid.Column="1"
                                           Grid.ColumnSpan="2"
                                           Height="1"
                                           Fill="#33FFFFFF"
                                           VerticalAlignment="Bottom" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <ProgressRing x:Name="LoadingIndicator" IsActive="False" Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock x:Name="EmptyStateText"
                           x:Uid="PhoneUi_Text_NoSongsFound"
                           FontSize="30"
                           FontWeight="Light"
                           Foreground="White"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="42"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Grid>
        </Grid>
    </Grid>
</Page>
