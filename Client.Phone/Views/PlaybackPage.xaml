<Page x:Class="Mixdrome.Phone.Views.PlaybackPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:common="using:Mixdrome.Phone.Common"
      Background="{StaticResource ApplicationPageBackgroundThemeBrush}">
    <Page.Resources><SolidColorBrush x:Key="PlayerFeedbackNeutralBrush" Color="#33000000" /></Page.Resources>
    <Page.BottomAppBar>
        <CommandBar x:Name="PlayerCommandBar" SizeChanged="OnPlayerCommandBarSizeChanged" ClosedDisplayMode="Minimal" Background="#CC202020" Foreground="White">
            <CommandBar.SecondaryCommands>
                <AppBarButton x:Name="NowPlayingMenu" Click="OnNowPlayingMenuClick" />
                <AppBarButton x:Name="AboutMenu" Click="OnAboutMenuClick" />
                <AppBarButton x:Name="QueueMenu" Click="OnQueueMenuClick" />
                <AppBarButton x:Name="SaveOfflineMixMenu" Click="OnSaveOfflineMixClick" Visibility="Collapsed" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Page.BottomAppBar>
    <Grid x:Name="PlayerRoot" Background="Black" SizeChanged="OnPlayerSizeChanged">
        <Image x:Name="BackgroundImage" Stretch="UniformToFill" Opacity="1" />
        <Image x:Name="BackgroundPreloadImage" Stretch="UniformToFill" Opacity="0" IsHitTestVisible="False" />
        <Grid x:Name="PlayerContent">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <common:PhoneTitleBar x:Name="PlayerTitleBar" Background="#4D303030" />
            <Pivot x:Name="PlayerPivot" Grid.Row="1" Margin="0,4,0,0">
                <PivotItem x:Uid="Playback_NowPlaying">
                    <Grid Margin="8,0,8,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button x:Name="ShuffleButton" x:Uid="Playback_Shuffle" Width="60" Height="60"
                                    Style="{StaticResource MixRadioFlatButtonStyle}" Click="OnShuffleClick">
                                <TextBlock Text="&#xE14B;" FontFamily="Segoe UI Symbol" FontSize="32"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Button>
                            <Button x:Name="RepeatButton" x:Uid="Playback_Repeat" Width="60" Height="60"
                                    Style="{StaticResource MixRadioFlatButtonStyle}" Click="OnRepeatClick">
                                <Grid>
                                    <TextBlock Text="&#xE149;" FontFamily="Segoe UI Symbol" FontSize="32"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock x:Name="RepeatOneBadge" x:Uid="PhoneUi_Text_1" FontSize="13" FontWeight="Bold"
                                               Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Button>
                        </StackPanel>
                        <Grid Grid.Row="1" Margin="0,10,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.44*" />
                                <ColumnDefinition Width="0.56*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="AlbumArtBorder" Background="{StaticResource MixRadioPanelAltBrush}"
                                    SizeChanged="OnArtworkSizeChanged" VerticalAlignment="Bottom">
                                <Image x:Name="AlbumArtImage" Stretch="UniformToFill"
                                       Source="ms-appx:///Assets/MixRadio/DefaultArtwork300.png" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="16,0,0,0">
                                <TextBlock x:Name="SongTitleText" FontSize="27" FontWeight="Bold" LineHeight="30"
                                           Foreground="White" TextWrapping="Wrap" MaxLines="2" />
                                <TextBlock x:Name="ArtistText" FontSize="17" Foreground="White"
                                           TextWrapping="Wrap" MaxLines="2" Margin="0,8,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="PlaybackStatusText" Grid.Row="2" Foreground="White" FontSize="14"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                    </Grid>
                </PivotItem>
                <PivotItem x:Uid="Playback_About">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="8,0,8,0">
                        <StackPanel>
                            <TextBlock x:Name="AboutTitleText" Style="{StaticResource HeaderTextStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="Playback_ArtistLabel" Style="{StaticResource BodyTextStyle}" Margin="0,24,0,4" />
                            <TextBlock x:Name="AboutArtistText" Style="{StaticResource TitleTextStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Uid="Playback_AlbumLabel" Style="{StaticResource BodyTextStyle}" Margin="0,24,0,4" />
                            <TextBlock x:Name="AboutAlbumText" Style="{StaticResource TitleTextStyle}" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </PivotItem>
                <PivotItem x:Uid="Playback_Queue">
                    <ListView x:Name="QueueListView" ItemsSource="{Binding QueueItems}" SelectionMode="Single"
                              Loaded="OnQueueListLoaded" Unloaded="OnQueueListUnloaded"
                              IsItemClickEnabled="True" ItemClick="OnQueueItemClick" Margin="0,0,-8,0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="MinHeight" Value="64" />
                                <Setter Property="Padding" Value="12,6" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Image Source="{Binding CoverArt}" Width="48" Height="48" Stretch="UniformToFill" />
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="20" TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        <TextBlock Text="{Binding Artist}" Style="{StaticResource BodyTextStyle}"
                                                   TextTrimming="CharacterEllipsis" MaxLines="1" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </PivotItem>
            </Pivot>
            <StackPanel x:Name="PlayerSidebar" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,12,0">
                <Button x:Name="ShareButton" Width="48" Height="48" MinWidth="0" MinHeight="0" Style="{StaticResource CircularButtonStyle}" Click="OnShareClick" Margin="0,0,0,24">
                    <Viewbox x:Name="ShareIcon" Width="45" Height="45"><Canvas Width="45" Height="45"><Path Data="F1 M 32.521,17.518 C 32.358,17.852 32.152,18.170 31.876,18.446 C 31.489,18.833 31.030,19.097 30.544,19.263 C 30.813,20.097 30.971,20.981 30.971,21.906 C 30.971,24.362 29.933,26.571 28.285,28.150 C 27.061,27.173 25.271,27.237 24.135,28.371 C 24.127,28.380 24.120,28.390 24.112,28.399 C 22.920,29.621 22.924,31.580 24.135,32.790 C 24.457,33.112 24.834,33.343 25.234,33.495 C 26.350,33.918 27.658,33.687 28.553,32.790 C 29.209,32.135 29.501,31.258 29.451,30.397 C 31.873,28.354 33.430,25.314 33.430,21.906 C 33.430,20.348 33.104,18.865 32.521,17.518 Z" Fill="White" /><Path Data="F1 M 13.943,24.239 C 13.994,24.194 14.049,24.162 14.095,24.114 C 14.725,23.485 15.022,22.652 15.001,21.825 C 14.982,21.052 14.686,20.283 14.095,19.696 C 13.102,18.700 11.606,18.532 10.425,19.159 C 10.158,19.302 9.902,19.471 9.677,19.696 C 8.458,20.913 8.458,22.897 9.677,24.114 C 10.220,24.659 10.917,24.945 11.630,25.004 C 12.688,28.645 15.553,31.512 19.192,32.572 C 18.906,31.744 18.937,30.835 19.293,30.029 C 16.705,29.070 14.695,26.919 13.943,24.239 Z" Fill="White" /><Path Data="F1 M 24.135,15.439 C 24.651,15.957 25.307,16.241 25.982,16.320 C 26.898,16.427 27.853,16.141 28.553,15.439 C 29.345,14.649 29.613,13.541 29.379,12.524 C 29.252,11.975 28.982,11.450 28.553,11.022 C 27.363,9.830 25.446,9.812 24.223,10.951 C 23.597,10.840 22.954,10.772 22.295,10.772 C 18.711,10.772 15.533,12.485 13.500,15.128 C 14.399,15.041 15.316,15.303 16.049,15.912 C 17.629,14.264 19.839,13.229 22.295,13.229 C 22.613,13.229 22.920,13.257 23.226,13.291 C 23.242,14.070 23.540,14.845 24.135,15.439 Z" Fill="White" /></Canvas></Viewbox>
                </Button>
                <Button x:Name="LyricsButton" Width="48" Height="48" MinWidth="0" MinHeight="0" Style="{StaticResource CircularButtonStyle}" Click="OnLyricsClick">
                    <TextBlock Text="&#x201C;" FontSize="48" FontFamily="Segoe UI" Margin="0,-2,0,0" />
                </Button>
            </StackPanel>
            <TextBlock Grid.Row="1" Text="{Binding Text, ElementName=PlaybackStatusText}" Visibility="{Binding Visibility, ElementName=MixNowPlayingPanel}"
                       Foreground="White" FontSize="14" Margin="24,8,24,0" VerticalAlignment="Top" TextWrapping="Wrap" />
            <Grid x:Name="MixNowPlayingPanel" Grid.Row="1" Visibility="Collapsed" Margin="24,0,24,-3" VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="MixAlbumArtBorder" Width="194" Height="194" Background="{StaticResource MixRadioPanelAltBrush}">
                    <Image x:Name="MixAlbumArtImage" Stretch="UniformToFill" />
                </Border>
                <Grid x:Name="MixDetailsGrid" Grid.Column="1" Margin="12,0,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock x:Name="MixSongTitleText" Foreground="White" FontSize="32" FontWeight="Bold"
                                   LineHeight="36" MaxLines="2" TextWrapping="Wrap" />
                        <TextBlock x:Name="MixArtistText" Foreground="White" FontSize="22" MaxLines="2" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid x:Name="MixFeedbackRow" Grid.Row="1" Margin="0,0,0,5">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Button x:Name="LikeButton" Width="44" Height="44" MinWidth="0" MinHeight="0"
                                Style="{StaticResource CircularButtonStyle}" Click="OnLikeClick" HorizontalAlignment="Left">
                            <Viewbox x:Name="LikeIcon" Width="44" Height="44"><Canvas Width="44" Height="44"><Path Data=" M 21.171,9.701 C 21.417,9.538 21.787,9.538 22.281,9.701 C 22.689,9.949 23.020,10.484 23.266,11.305 C 23.513,12.126 23.596,13.068 23.513,14.137 C 23.347,15.371 22.979,16.439 22.403,17.344 C 24.375,17.344 26.306,17.508 28.195,17.835 C 29.019,17.999 29.551,18.329 29.798,18.821 C 30.126,19.727 30.126,20.590 29.798,21.409 C 29.798,21.494 29.758,21.575 29.676,21.659 C 29.510,21.985 29.387,22.274 29.306,22.520 C 30.126,24.328 29.922,25.766 28.688,26.834 C 28.935,27.327 29.019,28.026 28.935,28.929 C 28.853,29.094 28.811,29.259 28.811,29.422 C 28.566,30.736 27.786,31.434 26.469,31.519 C 25.895,31.519 25.279,31.519 24.620,31.519 C 22.897,31.600 21.212,31.600 19.567,31.519 C 19.322,31.434 19.074,31.393 18.829,31.393 C 18.172,31.148 17.596,30.861 17.104,30.531 C 16.201,30.037 15.625,29.340 15.377,28.438 C 15.377,28.271 15.336,28.107 15.254,27.943 C 15.091,26.629 14.967,25.314 14.885,23.997 C 14.801,23.260 14.761,22.438 14.761,21.533 C 14.761,20.548 15.091,19.727 15.747,19.069 C 16.734,17.917 17.926,16.727 19.322,15.496 C 19.979,14.754 20.432,13.685 20.678,12.290 C 20.841,11.800 20.841,11.139 20.678,10.318 C 20.678,10.073 20.841,9.868 21.171,9.701 Z" Fill="White" /></Canvas></Viewbox>
                        </Button>
                        <Button x:Name="DislikeButton" Grid.Column="1" Width="44" Height="44" MinWidth="0" MinHeight="0"
                                Style="{StaticResource CircularButtonStyle}" Click="OnDislikeClick" HorizontalAlignment="Center">
                            <Viewbox x:Name="DislikeIcon" Width="44" Height="44"><Canvas Width="44" Height="44">
                                <Path Data=" M 21.171,9.701 C 21.417,9.538 21.787,9.538 22.281,9.701 C 22.689,9.949 23.020,10.484 23.266,11.305 C 23.513,12.126 23.596,13.068 23.513,14.137 C 23.347,15.371 22.979,16.439 22.403,17.344 C 24.375,17.344 26.306,17.508 28.195,17.835 C 29.019,17.999 29.551,18.329 29.798,18.821 C 30.126,19.727 30.126,20.590 29.798,21.409 C 29.798,21.494 29.758,21.575 29.676,21.659 C 29.510,21.985 29.387,22.274 29.306,22.520 C 30.126,24.328 29.922,25.766 28.688,26.834 C 28.935,27.327 29.019,28.026 28.935,28.929 C 28.853,29.094 28.811,29.259 28.811,29.422 C 28.566,30.736 27.786,31.434 26.469,31.519 C 25.895,31.519 25.279,31.519 24.620,31.519 C 22.897,31.600 21.212,31.600 19.567,31.519 C 19.322,31.434 19.074,31.393 18.829,31.393 C 18.172,31.148 17.596,30.861 17.104,30.531 C 16.201,30.037 15.625,29.340 15.377,28.438 C 15.377,28.271 15.336,28.107 15.254,27.943 C 15.091,26.629 14.967,25.314 14.885,23.997 C 14.801,23.260 14.761,22.438 14.761,21.533 C 14.761,20.548 15.091,19.727 15.747,19.069 C 16.734,17.917 17.926,16.727 19.322,15.496 C 19.979,14.754 20.432,13.685 20.678,12.290 C 20.841,11.800 20.841,11.139 20.678,10.318 C 20.678,10.073 20.841,9.868 21.171,9.701 Z" Fill="White">
                                    <Path.RenderTransform><RotateTransform Angle="180" CenterX="22" CenterY="22" /></Path.RenderTransform>
                                </Path>
                            </Canvas></Viewbox>
                        </Button>
                        <Button x:Name="FavouriteButton" Grid.Column="2" Width="44" Height="44" MinWidth="0" MinHeight="0"
                                Style="{StaticResource CircularButtonStyle}" Click="OnFavouriteClick" HorizontalAlignment="Right">
                            <Path x:Name="FavouriteIcon" Width="25" Height="25" Stretch="Uniform" Fill="White" Data="M 50,0 L 61.8,36.3 L 100,36.3 L 69.1,58.8 L 80.9,95.1 L 50,72.7 L 19.1,95.1 L 30.9,58.8 L 0,36.3 L 38.2,36.3 Z" />
                        </Button>
                    </Grid>
                </Grid>
            </Grid>
            <Grid x:Name="TransportPanel" Grid.Row="2" Margin="24,0,24,8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Keep a full touch surface while drawing the original thin progress track. -->
                <Slider x:Name="ProgressSlider" x:Uid="Playback_Seek" Minimum="0" Maximum="1" Height="44" Margin="0,-10,0,-10"
                        IsEnabled="False" ValueChanged="OnProgressSliderChanged" ManipulationMode="None" IsThumbToolTipEnabled="False"
                        Foreground="{StaticResource MixRadioAccentBrush}" Background="#66FFFFFF">
                    <Slider.Template>
                        <ControlTemplate TargetType="Slider">
                            <Grid x:Name="SliderContainer" Background="Transparent">
                                <Grid x:Name="HorizontalTemplate">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Rectangle x:Name="HorizontalTrackRect" Grid.ColumnSpan="3" Height="4" VerticalAlignment="Top" Margin="0,14,0,0" Fill="{TemplateBinding Background}" />
                                    <Rectangle x:Name="HorizontalDecreaseRect" Height="4" VerticalAlignment="Top" Margin="0,14,0,0" Fill="{TemplateBinding Foreground}" />
                                    <Thumb x:Name="HorizontalThumb" Grid.Column="1" Width="1" Height="44" Opacity="0" />
                                </Grid>
                            </Grid>
                        </ControlTemplate>
                    </Slider.Template>
                </Slider>
                <Grid Grid.Row="1" Margin="0,-10,0,6">
                    <TextBlock x:Name="CurrentTimeText" x:Uid="PhoneUi_Text_000" FontSize="13" Foreground="White" />
                    <TextBlock x:Name="TotalTimeText" x:Uid="PhoneUi_Text_000" FontSize="13" Foreground="White" HorizontalAlignment="Right" />
                </Grid>
                <Grid x:Name="TransportButtons" Grid.Row="2" Height="74" HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="PreviousColumn" Width="120" />
                        <ColumnDefinition x:Name="PlayPauseColumn" Width="120" />
                        <ColumnDefinition x:Name="NextColumn" Width="120" />
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PreviousButton" x:Uid="Playback_Previous" Click="OnPreviousClick"
                            Width="58" Height="58" MinWidth="0" MinHeight="0" Style="{StaticResource CircularButtonStyle}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE100;" FontFamily="Segoe UI Symbol" FontSize="28" />
                    </Button>
                    <Button x:Name="PlayPauseButton" Grid.Column="1" Click="OnPlayPauseClick"
                            Width="58" Height="58" MinWidth="0" MinHeight="0" Style="{StaticResource CircularButtonStyle}" HorizontalAlignment="Center">
                        <TextBlock x:Name="PlayPauseGlyph" Text="&#xE102;" FontFamily="Segoe UI Symbol" FontSize="30" />
                    </Button>
                    <Button x:Name="NextButton" x:Uid="Playback_Next" Grid.Column="2" Click="OnNextClick"
                            Width="58" Height="58" MinWidth="0" MinHeight="0" Style="{StaticResource CircularButtonStyle}" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE101;" FontFamily="Segoe UI Symbol" FontSize="28" />
                    </Button>
                </Grid>
            </Grid>
        </Grid>
        <Grid x:Name="LyricsOverlay" Visibility="Collapsed" Background="#D9000000" Margin="0,60,0,0">
            <ScrollViewer Margin="24,78,24,20" VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="LyricsText" TextWrapping="Wrap" FontSize="26" Foreground="White" />
            </ScrollViewer>
            <Button x:Name="CloseLyricsButton" Width="48" Height="48" MinWidth="0" MinHeight="0" Margin="0,10,12,0"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource CircularButtonStyle}" Click="OnCloseLyricsClick">
                <TextBlock Text="&#x201C;" FontSize="48" FontFamily="Segoe UI" Margin="0,-2,0,0" />
            </Button>
        </Grid>
        <Grid x:Name="FeedbackOverlay" Visibility="Collapsed" Background="#99000000">
            <Grid x:Name="FeedbackPanel" Background="{StaticResource MixRadioFeedbackBrush}" VerticalAlignment="Top" Height="328">
                <TextBlock x:Name="FeedbackTitleText" Foreground="White" FontSize="31" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,16,24,0" />
                <TextBlock x:Name="FeedbackMessageText" Foreground="White" FontSize="22" TextWrapping="Wrap" Width="320" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="24,88,0,0" />
                <Viewbox x:Name="FeedbackIcon" RenderTransformOrigin="0.5,0.5" Width="80" Height="80" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,68,24,0">
                    <Grid Width="44" Height="44"><Ellipse Fill="#33000000" Stroke="White" StrokeThickness="2" /><Path Data=" M 21.171,9.701 C 21.417,9.538 21.787,9.538 22.281,9.701 C 22.689,9.949 23.020,10.484 23.266,11.305 C 23.513,12.126 23.596,13.068 23.513,14.137 C 23.347,15.371 22.979,16.439 22.403,17.344 C 24.375,17.344 26.306,17.508 28.195,17.835 C 29.019,17.999 29.551,18.329 29.798,18.821 C 30.126,19.727 30.126,20.590 29.798,21.409 C 29.798,21.494 29.758,21.575 29.676,21.659 C 29.510,21.985 29.387,22.274 29.306,22.520 C 30.126,24.328 29.922,25.766 28.688,26.834 C 28.935,27.327 29.019,28.026 28.935,28.929 C 28.853,29.094 28.811,29.259 28.811,29.422 C 28.566,30.736 27.786,31.434 26.469,31.519 C 25.895,31.519 25.279,31.519 24.620,31.519 C 22.897,31.600 21.212,31.600 19.567,31.519 C 19.322,31.434 19.074,31.393 18.829,31.393 C 18.172,31.148 17.596,30.861 17.104,30.531 C 16.201,30.037 15.625,29.340 15.377,28.438 C 15.377,28.271 15.336,28.107 15.254,27.943 C 15.091,26.629 14.967,25.314 14.885,23.997 C 14.801,23.260 14.761,22.438 14.761,21.533 C 14.761,20.548 15.091,19.727 15.747,19.069 C 16.734,17.917 17.926,16.727 19.322,15.496 C 19.979,14.754 20.432,13.685 20.678,12.290 C 20.841,11.800 20.841,11.139 20.678,10.318 C 20.678,10.073 20.841,9.868 21.171,9.701 Z" Fill="White" /></Grid>
                </Viewbox>
                <Button x:Name="FeedbackOkButton" Width="204" Height="48" MinWidth="0" MinHeight="0" Padding="0" BorderThickness="3" BorderBrush="White"
                        Background="Transparent" Foreground="White" FontSize="24" FontWeight="SemiBold" Click="OnFeedbackOkClick" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="26,256,0,0">
                    <Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate></Button.Template>
                </Button>
            </Grid>
        </Grid>
    </Grid>
</Page>
