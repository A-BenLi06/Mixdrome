<Page x:Class="Mixdrome.Phone.Views.MainPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:Mixdrome.Phone.Common" Background="Black">
 <Page.BottomAppBar><CommandBar x:Name="MenuBar" Background="#B3202020" Visibility="Collapsed"><AppBarButton Icon="Setting" x:Uid="PhoneUi_Label_Settings" Click="OnSettingsClick"/><AppBarButton Icon="Help" x:Uid="PhoneUi_Label_Help" Click="OnHelpClick"/></CommandBar></Page.BottomAppBar>
 <Grid x:Name="Root">
  <Canvas><Image x:Name="ArtistBackdrop" Stretch="UniformToFill" HorizontalAlignment="Left" VerticalAlignment="Top"><Image.RenderTransform><TranslateTransform x:Name="BackdropTranslation"/></Image.RenderTransform></Image></Canvas>
  <Rectangle Fill="Black" Opacity="0.3" IsHitTestVisible="False"/>
  <Grid x:Name="HomeHeader" VerticalAlignment="Top" IsHitTestVisible="False">
   <TextBlock x:Name="Wordmark" Foreground="White" FontWeight="Light" FontFamily="Segoe WP" TextWrapping="NoWrap"><Run x:Uid="PhoneUi_Brand_Lead" FontWeight="Bold"/><Run x:Uid="PhoneUi_Brand_Tail" FontWeight="Light"/></TextBlock>
  </Grid>
  <ScrollViewer x:Name="Panorama" HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" ZoomMode="Disabled" HorizontalSnapPointsType="None" ViewChanged="OnPanoramaViewChanged">
   <StackPanel x:Name="Sections" Orientation="Horizontal" AreScrollSnapPointsRegular="False">
    <Grid x:Name="PlaySection"><local:PhoneHomePanel x:Name="HomeTiles" HorizontalAlignment="Left" VerticalAlignment="Stretch" TileClicked="OnTileClicked"/></Grid>
    <Grid x:Name="MenuSection" VerticalAlignment="Top">
     <Grid.RowDefinitions><RowDefinition x:Name="MenuRowOne"/><RowDefinition x:Name="MenuRowTwo"/><RowDefinition x:Name="MenuRowThree"/></Grid.RowDefinitions>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
     <Button x:Name="MixesTile" Tag="mixes" Style="{StaticResource PhoneMenuTileStyle}" Click="OnMenuClick"><Grid><Image Source="/Assets/MixRadio/MixesTileIcon.png" Stretch="Uniform"/><TextBlock x:Uid="PhoneUi_Text_Mixes" Style="{StaticResource PhoneTileLabelStyle}"/></Grid></Button>
     <Button x:Name="CreateTile" Grid.Column="1" Tag="create" Style="{StaticResource PhoneMenuTileStyle}" Click="OnMenuClick"><Grid><Image Source="/Assets/MixRadio/CreateTileIcon.png" Stretch="Uniform"/><TextBlock x:Uid="PhoneUi_Text_CreateMix" Style="{StaticResource PhoneTileLabelStyle}"/></Grid></Button>
     <Button x:Name="FavouritesTile" Grid.Row="1" Grid.ColumnSpan="2" Tag="favourites" Style="{StaticResource PhoneMenuTileStyle}" Click="OnMenuClick"><Grid><Image Source="/Assets/MixRadio/FavouritesTileIcon.png" Stretch="Uniform"/><TextBlock x:Uid="PhoneUi_Text_Favourites" Style="{StaticResource PhoneTileLabelStyle}"/></Grid></Button>
     <Button x:Name="MusicTile" Grid.Row="2" Tag="library" Style="{StaticResource PhoneMenuTileStyle}" Click="OnMenuClick"><Grid><Image Source="/Assets/MixRadio/MyMusicTileIcon.png" Stretch="Uniform"/><TextBlock x:Uid="PhoneUi_Text_MyMusic" Style="{StaticResource PhoneTileLabelStyle}"/></Grid></Button>
     <Button x:Name="OfflineTile" Grid.Row="2" Grid.Column="1" Tag="offline" Style="{StaticResource PhoneMenuTileStyle}" Click="OnMenuClick"><Grid><Image Source="/Assets/MixRadio/OfflineTileIcon.png" Stretch="Uniform"/><TextBlock x:Uid="PhoneUi_Text_OfflineMixes" Style="{StaticResource PhoneTileLabelStyle}"/></Grid></Button>
    </Grid>
   </StackPanel>
  </ScrollViewer>
  <Border x:Name="StatusBanner" VerticalAlignment="Bottom" Background="#D9101010" Padding="14,10" Margin="12" IsHitTestVisible="False" Visibility="Collapsed">
   <StackPanel><TextBlock x:Name="StatusText" Style="{StaticResource BodyTextStyle}" TextWrapping="Wrap"/><ProgressRing x:Name="LoadingIndicator" Width="32" Height="32" Visibility="Collapsed"/></StackPanel>
  </Border>
 </Grid>
</Page>
